<h1>投稿一覧</h1>
<%= link_to "新規投稿", new_post_path, class: "button" %>

<div class="posts-container">
  <% @posts.each do |post| %>
    <div class="post-card">

      <!-- 写真 -->
      <div class="post-image-box">
        <% if post.photo.attached? %>
          <%= image_tag post.photo, class: "post-image" %>
        <% elsif post.image.attached? %>
          <%= image_tag post.image, class: "post-image" %>
        <% else %>
          <p>画像なし</p>
        <% end %>
      </div>

      <!-- 投稿内容 -->
      <div class="post-content">

        <p><strong>投稿者:</strong> <%= post.user_name %> (<%= post.gender == "male" ? "男性" : "女性" %>)</p>

        <p><strong>バイク名:</strong> <%= post.name %></p>

        <p><strong>カスタム:</strong> <%= post.custom %></p>

        <p><strong>コメント:</strong> <%= post.comment %></p>

        <p><strong>いいね:</strong> <%= post.likes %></p>

        <%= button_to "いいね", like_post_path(post), method: :post %>
        <%= button_to "いいね取り消し", unlike_post_path(post), method: :post %>

        <p><%= link_to "詳細", post_path(post) %></p>

      </div>

    </div>
  <% end %>
</div>
