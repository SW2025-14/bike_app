<h1 class="posts-title">
  🏍 みんなのバイク投稿
</h1>

<div class="posts-header-bar">
  <%= link_to "新規投稿", new_post_path, class: "button" %>
</div>

<div class="posts-container">
  <% @posts.each do |post| %>
    <div class="post-card">

      <!-- 写真 -->
      <div class="post-image-box">
        <% if post.photo.attached? %>
          <%= image_tag post.photo, class: "post-image" %>
        <% else %>
          <p>画像なし</p>
        <% end %>
      </div>

      <!-- 投稿内容 -->
      <div class="post-content">
        <p><strong>投稿者:</strong> <%= post.user_name %>
          (<%= post.gender == "male" ? "男性" : "女性" %>)
        </p>

        <p><strong>バイク名:</strong> <%= post.name %></p>
        <p><strong>コメント:</strong> <%= post.comment %></p>
        <p><strong>いいね:</strong> <%= post.likes %></p>

        <%= button_to "👍", like_post_path(post), method: :post %>
        <%= button_to "👎", unlike_post_path(post), method: :post %>

        <%= link_to "削除",
            post_path(post),
            data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
            class: "delete-button" %>

      </div>

    </div>
  <% end %>
</div>
