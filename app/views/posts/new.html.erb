<h1>新規投稿</h1>

<%= form_with model: @post, local: true, html: { multipart: true } do |f| %>

  <div>
    <%= f.label :user_name, "あなたの名前" %>
    <%= f.text_field :user_name %>
  </div>

  <div>
    <%= f.label :gender, "性別" %>
    <%= f.select :gender, ["男", "女"] %>
  </div>

  <div>
    <%= f.label :name, "バイクの名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :photo, "写真" %>
    <%= f.file_field :photo %>
  </div>

  <div>
    <%= f.label :comment, "コメント" %>
    <%= f.text_area :comment %>
  </div>

  <div>
    <%= f.submit "投稿する" %>
  </div>
<% end %>

<%= link_to "投稿一覧に戻る", posts_path %>
