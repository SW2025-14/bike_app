<h1>新規投稿</h1>

<%= form_with model: @post, local: true do |f| %>

  <!-- 名前 -->
  <p>
    名前：<br>
    <%= f.text_field :name %>
  </p>

  <!-- 写真アップロード -->
  <p>
    写真：<br>
    <%= f.file_field :image %>
  </p>

  <!-- カスタム内容 -->
  <p>
    カスタム：<br>
    <%= f.text_field :custom %>
  </p>

  <!-- 性別 -->
  <p>
    性別：<br>
    <%= f.select :gender, [["男性", "male"], ["女性", "female"]] %>
  </p>

  <!-- コメント -->
  <p>
    コメント：<br>
    <%= f.text_area :comment %>
  </p>

  <p>
    <%= f.submit "投稿する" %>
  </p>

<% end %>
