<div class="post-page">
  <div class="post-form">
    <h1>新規投稿</h1>

    <%= form_with model: @post, local: true, html: { multipart: true } do |f| %>

      <div class="form-group">
        <%= f.label :user_name, "あなたの名前" %>
        <%= f.text_field :user_name %>
      </div>

      <div class="form-group">
        <%= f.label :gender, "性別" %>
        <%= f.select :gender, [["男性", "male"], ["女性", "female"]] %>
      </div>

      <div class="form-group">
        <%= f.label :name, "バイクの名前" %>
        <%= f.text_field :name %>
      </div>

      <div class="form-group">
        <%= f.label :photo, "写真" %>
        <%= f.file_field :photo %>
      </div>

      <div class="form-group">
        <%= f.label :comment, "コメント" %>
        <%= f.text_area :comment %>
      </div>

      <div class="form-actions">
        <%= f.submit "投稿する", class: "submit-button" %>
      </div>

    <% end %>

    <div class="back-link">
      <%= link_to "投稿一覧に戻る", posts_path %>
    </div>
  </div>
</div>
